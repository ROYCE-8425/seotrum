{
  "site": {
    "title": "Sèo Trum — Dịch Vụ Tự Động Hoá (Automation) & Phần Mềm Theo Yêu Cầu",
    "base_url": "https://seotrum.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/brand-logo.png",
    "logo_darkmode": "/images/brand-logo.png",
    "logo_width": "176",
    "logo_height": "65",
    "logo_text": "Sèo Trum"
  },

  "settings": {
    "search": false,
    "searchable_folders": ["blog", "authors"],
    "sticky_header": true,
    "theme_switcher": false,
    "default_theme": "light",
    "pagination": 6,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": false,
    "content": "",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#tu-van",
    "copyright": "© 2026 Sèo Trum"
  },

  "navigation_button": {
    "enable": true,
    "label": "Trao đổi bài toán",
    "link": "#tu-van"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": ""
  },

  "disqus": {
    "enable": false,
    "shortname": "",
    "settings": {}
  },

  "metadata": {
    "meta_author": "Sèo Trum",
    "meta_image": "/images/og-image.png",
    "meta_description": "Sèo Trum cung cấp dịch vụ tự động hoá (automation), xây dựng phần mềm, web app, bot và tích hợp API theo yêu cầu giúp doanh nghiệp giảm thao tác thủ công và vận hành gọn hơn."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": false,
    "include": [],
    "exclude": ["/elements"]
  }
}
